{
	"environment": {
		"sslCertificate": {
			"publicKeyFile": "$PUBLIC_PEM",
			"privateKeyFile": "$PRIVATE_PEM",
			"passphraseFile": "$PASSPHRASE_TXT"
		},
		"favicon": "favicon.png",
		"loginPage": {
			"title": "Login into My Chess Club",
			"icon": "login.png"
		},
		"homePage": {
			"title": "My Chess Club",
			"icon": "home.png"
		}
	},

	"server": {
		"domainName": "$DOMAIN_NAME",
		"ports": {
			"http": "8080",
			"https": "8443"
		}
	},

	"ratingSystem": "Elo",

	"timeControls": [
		{
			"id": "Classical",
			"name": "Classical (90 + 30)"
		},
		{
			"id": "Rapid",
			"name": "Rapid (12 + 5)"
		},
		{
			"id": "Rapid",
			"name": "Rapid (10 + 0)"
		},
		{
			"id": "Blitz",
			"name": "Blitz (5 + 3)"
		}
	],

	"behavior": {
		"challenges": {
			"higherRatedPlayerCanDeclineChallengeFromLowerRatedPlayer": false
		}
	},

	"permissions": {
		"admin": [
			"CREATE_USER",

			"ASSIGN_ROLE_USERS_ADMIN",
			"ASSIGN_ROLE_USERS_TEACHER",
			"ASSIGN_ROLE_USERS_MEMBER",
			"ASSIGN_ROLE_USERS_STUDENT",

			"CREATE_GAMES_ADMIN",
			"CREATE_GAMES_TEACHER",
			"CREATE_GAMES_MEMBER",
			"CREATE_GAMES_STUDENT",
			"DELETE_GAMES_ADMIN",
			"DELETE_GAMES_TEACHER",
			"DELETE_GAMES_MEMBER",
			"DELETE_GAMES_STUDENT",
			"SEE_GAMES_ADMIN",
			"SEE_GAMES_TEACHER",
			"SEE_GAMES_MEMBER",
			"SEE_GAMES_STUDENT",
			"EDIT_GAMES_ADMIN",
			"EDIT_GAMES_TEACHER",
			"EDIT_GAMES_MEMBER",
			"EDIT_GAMES_STUDENT",

			"EDIT_ADMIN",
			"EDIT_TEACHER",
			"EDIT_MEMBER",
			"EDIT_STUDENT",

			"CHALLENGE_ADMIN",
			"CHALLENGE_MEMBER",
			"CHALLENGE_TEACHER",
			"CHALLENGE_STUDENT"
		],
		"teacher": [
			"CREATE_USER",
			"ASSIGN_ROLE",

			"EDIT_STUDENT",
			"EDIT_GAMES_STUDENT",
			"SEE_GAMES_STUDENT",
			"CHALLENGE_ADMIN",
			"CHALLENGE_MEMBER",
			"CHALLENGE_TEACHER",
			"CHALLENGE_STUDENT"
		],
		"member": ["CHALLENGE_ADMIN", "CHALLENGE_MEMBER", "CHALLENGE_TEACHER"],
		"student": ["CHALLENGE_ADMIN", "CHALLENGE_MEMBER", "CHALLENGE_TEACHER", "CHALLENGE_STUDENT"]
	}
}
